{
  "name": "ai-web-testing-platform",
  "private": true,
  "scripts": {
    "predev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-dev-processes.ps1",
    "dev": "concurrently -k -n FE,BE -c cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-dev-processes.ps1",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python -m uvicorn backend.server:app --reload --reload-dir backend --host 127.0.0.1 --port 8001",
    "install:all": "npm --prefix frontend install && python -m pip install -r backend/requirements.txt",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test:backend": "python -m pytest -q backend/tests"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
